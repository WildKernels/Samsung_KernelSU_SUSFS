+/* ============================================================================
+ * Enhanced KernelSU Root Path Management for S23 Ultra
+ * ============================================================================ */
+
+static int ksu_setup_su_path(void)
+{
+	/* Auto-add common SU paths for compatibility */
+	struct su_path_entry {
+		const char *path;
+		int priority;
+	} paths[] = {
+		{"/system/bin/su", 100},
+		{"/system/xbin/su", 90},
+		{"/data/local/tmp/ksu/bin/su", 80},
+		{"/data/adb/ksu/bin/su", 85},
+	};
+
+	int i;
+	for (i = 0; i < ARRAY_SIZE(paths); i++) {
+		ksu_auto_add_su_path(paths[i].path, paths[i].priority);
+	}
+
+	return 0;
+}
