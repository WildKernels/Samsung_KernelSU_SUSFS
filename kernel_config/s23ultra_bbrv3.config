# Samsung Galaxy S23 Ultra Kernel Configuration with KernelSU + BBRv3
# For OneUI 8.5 / Android 16

# ============================================================================
# KernelSU ROOT ACCESS CONFIGURATION (ENABLED)
# ============================================================================
CONFIG_KERNELSU=y
CONFIG_KERNELSU_DEBUG=n
CONFIG_KERNELSU_GIT_VERSION="true"

# KernelSU Security
CONFIG_KERNELSU_SELINUX_POLICY_FILE=""
CONFIG_KERNELSU_PROFILE="false"

# KernelSU SELinux Integration
CONFIG_KERNELSU_ENABLE_SELINUX_ENFORCE=y

# KernelSU Module Support
CONFIG_KERNELSU_SUPPORT_MODULES=y

# ============================================================================
# SUSFS ROOT HIDING CONFIGURATION (ENABLED)
# ============================================================================
CONFIG_SUSFS=y
CONFIG_SUSFS_SU_PATH="/system/bin/su"
CONFIG_SUSFS_HIDE_KSU_SUSFS=y
CONFIG_SUSFS_AUTO_ADD_SU_PATH=y
CONFIG_SUSFS_AUTO_ADD_SU_KSU_DEFAULT_MOUNT_INFO=y
CONFIG_SUSFS_SU_ALLOW_SYSFS_AUTOMATION=y
CONFIG_SUSFS_TRY_UMOUNT_FOR_UPGRADDING=y
CONFIG_SUSFS_AUTO_ADD_SU_PATH_FOR_EACH_VOLD_MOUNT=y
CONFIG_SUSFS_ENABLE_LOG=n

# ============================================================================
# TCP/IP CONFIGURATION
# ============================================================================
CONFIG_INET=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y

# BBRv3 TCP Congestion Control (ENABLED)
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_RENO=y

# Network performance tuning
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_CLS_FQ_CODEL=y
CONFIG_NETFILTER_XT_MATCH_BPF=y

# ============================================================================
# OPTIMIZATION FLAGS
# ============================================================================
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_FULL=y
CONFIG_CFI_CLANG=y
CONFIG_SHADOW_CALL_STACK=y

# Performance tuning
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_OPTIMIZE_INLINING=y

# ============================================================================
# SECURITY FEATURES
# ============================================================================
CONFIG_SECURITY=y
CONFIG_SECURITY_LSM="lockdown,capability,selinux"
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=n
CONFIG_SECURITY_SELINUX_BOOTPARAM=y

# Baseband Guard (Critical Partition Protection)
CONFIG_BASEBAND_GUARD=y
CONFIG_BBG_PROTECT_RIL_SOCKET=y
CONFIG_BBG_PROTECT_BOOTLOADER=y

# ============================================================================
# FILE SYSTEM CONFIGURATION
# ============================================================================
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ============================================================================
# DEVICE DRIVERS - Exynos 9925
# ============================================================================
CONFIG_EXYNOS_SOC=y
CONFIG_EXYNOS_CHIPID=y
CONFIG_EXYNOS_REBOOT=y
CONFIG_EXYNOS_PMU=y
CONFIG_EXYNOS_PM_DOMAINS=y
CONFIG_EXYNOS_HSI2C=y
CONFIG_PINCTRL_EXYNOS=y

# GPU (Mali G78)
CONFIG_DRM=y
CONFIG_DRM_MALI=y
CONFIG_MALI_MIDGARD=y
CONFIG_MALI_BIFROST=y

# ============================================================================
# AUDIO CONFIGURATION
# ============================================================================
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SAMSUNG=y
CONFIG_SND_SAMSUNGAUDIO=y

# ============================================================================
# USB CONFIGURATION
# ============================================================================
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_CONFIGFS=y

# ============================================================================
# DISPLAY CONFIGURATION
# ============================================================================
CONFIG_DRM_PANEL_SAMSUNG=y
CONFIG_LCD_CLASS_DEVICE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# ============================================================================
# CAMERA CONFIGURATION
# ============================================================================
CONFIG_MEDIA_SUPPORT=y
CONFIG_CAMERA_SUPPORT=y
CONFIG_V4L_PLATFORM_DRIVERS=y

# ============================================================================
# FINGERPRINT AND SENSORS
# ============================================================================
CONFIG_INPUT_FINGERPRINT=y
CONFIG_SENSORS_SSC=y

# ============================================================================
# ADDITIONAL FEATURES
# ============================================================================

# Droidspaces (Linux Container Support)
CONFIG_DROIDSPACES=y
CONFIG_NAMESPACE_NET=y
CONFIG_NAMESPACE_PID=y
CONFIG_NAMESPACE_USER=y
CONFIG_NAMESPACE_IPC=y

# NTSync (Windows NT Synchronization)
CONFIG_NTSYNC=y

# Unicode Bypass Fix
CONFIG_UNICODE_NORMALIZATION=y

# ============================================================================
# DEBUG AND LOGGING (DISABLED FOR PRODUCTION)
# ============================================================================
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_MEMORY_INIT=n
CONFIG_DEBUG_SPINLOCK=n
CONFIG_DEBUG_MUTEXES=n
CONFIG_DEBUG_RWSEMS=n
CONFIG_DEBUG_BUGVERBOSE=n
CONFIG_DEBUG_VM=n
CONFIG_DEBUG_VM_RB=n

# ============================================================================
# MODULE SUPPORT
# ============================================================================
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=y

# ============================================================================
# KERNEL VERSION INFORMATION
# ============================================================================
CONFIG_LOCALVERSION="-S918B-OneUI8-KernelSU-SUSFS-BBRv3"
CONFIG_LOCALVERSION_AUTO=n
